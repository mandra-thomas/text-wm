# Copy to pace.env (gitignored) and fill in your ICE account details.
# pace/_common.sh reads it for every job. PROJECT_ROOT must be this checkout, or jobs stop.

# Slurm
export PACE_ACCOUNT="coc"                # #SBATCH --account
export PACE_QOS="coc-ice"                # as allocated
export PACE_PARTITION="coc-gpu"          # coc-cpu is for pace/verify_env.sbatch
export PACE_GRES="gpu:A100:1"            # A100+ required for vLLM; not V100
export PACE_MAIL=""                      # optional: you@gatech.edu

# Paths on ICE (use project/scratch — never $HOME for weights)
export PROJECT_ROOT="/storage/coda1/p-YOUR/YOUR_USER/text-wm-pilot"
export WORD2WORLD_ROOT="${PROJECT_ROOT}/third_party/Word2World"
export HF_HOME="${PROJECT_ROOT}/hfcache"
export TRANSFORMERS_CACHE="${HF_HOME}"
export HF_HUB_CACHE="${HF_HOME}/hub"
export RUNS_DIR="${PROJECT_ROOT}/runs"
export ALFWORLD_DATA="${WORD2WORLD_ROOT}/data/alfworld"

# Envs (conda or uv venvs created in Phase 2)
export AGENTGYM_ENV="${PROJECT_ROOT}/.envs/agentgym"
export SERVE_ENV="${PROJECT_ROOT}/.envs/serve"

# Hugging Face (Llama-3.1-8B-Instruct is gated)
export HF_TOKEN=""                       # or rely on `huggingface-cli login`

# Serving
export VLLM_PORT=8000
export VLLM_MODEL="Qwen/Qwen3-8B"
export VLLM_MAX_MODEL_LEN=8192
export ALFWORLD_PORT=36001

# Offline after prefetch
# export HF_HUB_OFFLINE=1
# export TRANSFORMERS_OFFLINE=1
