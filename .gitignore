# Secrets / local PACE config
pace/pace.env
.env
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
wishful_foresight.egg-info/
.pytest_cache/
.venv/
venv/
.envs/
.pytest_cache/
