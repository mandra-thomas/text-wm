# Runs: results stay out of git, so a clone never carries an old PASS
runs/**
!runs/
!runs/.gitkeep
!runs/*/
!runs/FILED.txt
!runs/env.json

# Mock runs and their calibration values
runs_mock/

# Values each pilot run writes for the next stage
wf/config/calibrated.yaml
wf/config/eligible_target.yaml

# Caches / third party on cluster
hfcache/
third_party/
logs/
*.out
*.err

# OS / IDE
.DS_Store
.idea/
.vscode/

# Proposal / prereg PDFs (keep local)
*.pdf

# Tool caches kept off the ICE home quota (pace/_common.sh)
.cache/

# TextCraft recipe database: Minecraft game data, rebuilt by python -m wf.textcraft.freeze, never committed
wf/textcraft/data/recipes_frozen.json

# Local copies of cluster data for re-analysis (never committed)
data_local/
